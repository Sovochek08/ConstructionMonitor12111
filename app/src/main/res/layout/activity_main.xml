<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <!-- БЛОК ШУМОМЕРА -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="УРОВЕНЬ ШУМА (дБ)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#555555" />

            <TextView
                android:id="@+id/tvNoiseValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 дБ"
                android:textSize="48sp"
                android:textStyle="bold"
                android:textColor="#2E7D32"
                android:layout_marginVertical="8dp" />

            <ProgressBar
                android:id="@+id/pbNoise"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:max="120"
                android:progress="0" />

            <TextView
                android:id="@+id/tvNoiseStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Норма (до 80 дБ)"
                android:textSize="14sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvMaxNoise"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Пик: 0.0 дБ"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- БЛОК ВИБРОМЕТРА -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="УРОВЕНЬ ВИБРАЦИИ (м/с²)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#555555" />

            <TextView
                android:id="@+id/tvVibrationValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00 м/с²"
                android:textSize="48sp"
                android:textStyle="bold"
                android:textColor="#2E7D32"
                android:layout_marginVertical="8dp" />

            <ProgressBar
                android:id="@+id/pbVibration"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:max="100"
                android:progress="0" />

            <TextView
                android:id="@+id/tvVibrationStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Безопасно"
                android:textSize="14sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvMaxVibration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Пик: 0.00 м/с²"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- КНОПКА СБРОСА -->
    <Button
        android:id="@+id/btnReset"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Сбросить пиковые значения"
        android:textSize="16sp" />

</LinearLayout>